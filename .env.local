# .env.local
LOG_LEVEL=debug

SCRAPER_WRITE_FILES=True
SCRAPER_SHALLOW_CRAWL=False
SCRAPER_SYNC_SAVING=True
SCRAPER_JOB_LOOPED=False
SCRAPER_CRON_RUNNING=False
SCRAPER_SINGLE_RUNNING=True
SCRAPER_SLEEPING_TIME=10
SCRAPER_INTERVAL_SECONDS=1800
SCRAPER_MULTI_PROCESSING_CHUNKS=2
SCRAPER_PER_DOMAIN_CONCURRENCY=2
SCRAPER_MAX_DOMAINS_IN_PARALLEL=2

MEILI_URL=http://localhost:7700
MEILI_BOOTSTRAP_INTERNAL=False
